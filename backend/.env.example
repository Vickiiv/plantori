# ANPASSEN: alle Werte in dieser Datei sind projektspezifisch. Diese Datei
# zu .env kopieren (nicht umbenennen - .env bleibt zusaetzlich bestehen
# und wird von git nie mitgetrackt), dann hier eintragen:

PORT=4000

# Eigene MongoDB-Datenbank (z.B. aus einem MongoDB-Atlas-Projekt)
MONGO_URI=mongodb://localhost:27017/auth-starter

# Langer, zufaelliger String - fuer jedes Projekt neu generieren, nie wiederverwenden
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# URL, unter der das Frontend laeuft (fuer CORS und Links in Emails)
CLIENT_URL=http://localhost:5173

NODE_ENV=development

# Von resend.com - am besten ein eigenes Resend-Projekt pro App anlegen
RESEND_API_KEY=re_your_api_key

# Absenderadresse fuer Emails - Projektname hier UND in
# frontend/src/config.ts (APP_NAME) anpassen
MAIL_FROM=App-Name <onboarding@resend.dev>

# true = Email-Verifizierung wird fuer geschuetzte Routen erzwungen
# (siehe backend/src/middleware/requireVerified.ts)
ENFORCE_EMAIL_VERIFICATION=false
